{
  "name": "naur",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "services/naurffxiv",
    "packages/shared",
    "tests/e2e"
  ],
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.29.2"
  },
  "packageManager": "pnpm@10.29.2",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@j178/prek": "^0.4.12",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "prepare": "prek install",
    "build:naur": "turbo run build --filter=naurffxiv",
    "dev:naur": "pnpm --filter naurffxiv dev",
    "lint:naur": "pnpm --filter naurffxiv lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter e2e-tests test",
    "start:naur": "pnpm --filter naurffxiv start"
  },
  "overrides": {
    "glob": "^11.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4",
      "rollup": ">=4.59.0",
      "vite": "^7.3.2",
      "js-yaml": "^4.3.0",
      "brace-expansion": "5.0.8",
      "next>postcss": "8.5.18",
      "sharp@<0.35.0": "0.35.3",
      "flatted": "3.4.2",
      "ajv": "6.14.0",
      "minimatch@^3.1.0": "3.1.5",
      "minimatch@^9.0.5": "9.0.7",
      "picomatch@^2.3.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.4",
      "yaml@^2.8.0": "2.8.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
