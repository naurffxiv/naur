{
  "name": "naur",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "services/naurffxiv",
    "packages/shared",
    "tests/e2e"
  ],
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.20.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@j178/prek": "^0.4.12",
    "eslint": "^9.24.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "scripts": {
    "prepare": "prek install",
    "build:naur": "turbo run build --filter=naurffxiv",
    "dev:naur": "pnpm --filter naurffxiv dev",
    "lint": "eslint .",
    "lint:naur": "pnpm --filter naurffxiv lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter e2e-tests test",
    "start:naur": "pnpm --filter naurffxiv start"
  },
  "overrides": {
    "glob": "^11.0.0"
  }
}
