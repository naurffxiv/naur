{
  "name": "naurffxiv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.29.2"
  },
  "scripts": {
    "dev": "pnpm check:routes && pnpm exec next dev",
    "build": "pnpm exec next build",
    "start": "pnpm exec next start",
    "lint": "pnpm exec next lint",
    "test": "pnpm --filter naurffxiv-tests test",
    "typecheck": "tsc --noEmit",
    "prettier:check": "prettier --ignore-path ../../.prettierignore --check .",
    "prettier:write": "prettier --ignore-path ../../.prettierignore --write .",
    "check:routes": "tsx scripts/middleware/validateRoutes.ts",
    "compress": "tsx scripts/compress-images.ts"
  },
  "dependencies": {
    "@naur/shared": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.0",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@mui/x-data-grid": "^7.28.2",
    "@next/mdx": "15.5.22",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "next": "15.5.22",
    "next-auth": "^4.24.15",
    "next-mdx-remote": "^6.0.0",
    "node-cache": "^5.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-scrollspy-navigation": "^2.1.1",
    "react-slick": "^0.31.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-img-size": "^1.0.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.0.0",
    "remark-sectionize": "^2.1.0",
    "remark-toc": "^9.0.0",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "smol-toml": "^1.7.1",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "glob": "^13.0.6",
    "globals": "^17.8.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
